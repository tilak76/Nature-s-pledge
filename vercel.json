{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/ping",
            "destination": "/api/ping.js"
        },
        {
            "source": "/api/hello",
            "destination": "/api/hello.js"
        },
        {
            "source": "/api/db-check",
            "destination": "/api/db-check.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}